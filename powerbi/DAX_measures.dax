// =====================================================================
// DAX measures - Real Estate Sales & Portfolio Analytics Dashboard
// Tables used:  leads  (from cleaned_leads.csv / vw_monthly_kpi source)
//               agents (from cleaned_agents.csv)
//               Calendar (date table, created below)
//               Targets (optional, from targets.csv you maintain)
// Create measures in a dedicated "_Measures" table in Power BI.
// =====================================================================


// ---------- 1. Date table (create as a calculated table) ----------
// Calendar = ADDCOLUMNS(
//     CALENDAR(DATE(2025,1,1), DATE(2026,12,31)),
//     "Year",        YEAR([Date]),
//     "Month No",    MONTH([Date]),
//     "Month",       FORMAT([Date], "MMM YYYY"),
//     "Quarter",     "Q" & ROUNDUP ( MONTH ( [Date] ) / 3, 0 ) & "-" & YEAR ( [Date] )
// )
// Then: Mark as date table on the Date column.
// Relationship: leads[lead_date] (many) -> Calendar[Date] (one).


// ---------- 2. Core volume measures ----------

Total Leads =
COUNTROWS ( leads )

Won Leads =
CALCULATE ( [Total Leads], leads[is_won] = 1 )

Lost Leads =
CALCULATE ( [Total Leads], leads[is_lost] = 1 )

Open Leads =
CALCULATE ( [Total Leads], leads[is_open] = 1 )


// ---------- 3. Conversion measures ----------

// Share of ALL leads that were won (funnel view)
Lead Conversion Rate % =
DIVIDE ( [Won Leads], [Total Leads], 0 )

// Share of CLOSED deals that were won (sales-effectiveness view).
// This is the preferred KPI for agent and region comparison because it
// ignores leads still in progress.
Closed Win Rate % =
DIVIDE ( [Won Leads], [Won Leads] + [Lost Leads], 0 )

// Rate status used for conditional formatting on KPI cards
Win Rate Status =
SWITCH (
    TRUE (),
    [Closed Win Rate %] >= 0.30, "On Track",
    [Closed Win Rate %] >= 0.22, "Watch",
    "Action Needed"
)

// Rolling three-month closed win rate, smooths month-to-month noise
Closed Win Rate 3M =
CALCULATE (
    [Closed Win Rate %],
    DATESINPERIOD ( Calendar[Date], MAX ( Calendar[Date] ), -3, MONTH )
)


// ---------- 4. Revenue and pricing measures ----------

Revenue Won =
SUM ( leads[revenue_won] )

Avg Deal Size =
DIVIDE ( [Revenue Won], [Won Leads], 0 )

Avg Price per SqFt =
AVERAGE ( leads[price_per_sqft] )

Open Pipeline Value =
CALCULATE ( SUM ( leads[quoted_price] ), leads[is_open] = 1 )

Revenue Won (Crore) =
DIVIDE ( [Revenue Won], 10000000, 0 )


// ---------- 5. Time intelligence ----------

Revenue Won PY =
CALCULATE ( [Revenue Won], SAMEPERIODLASTYEAR ( Calendar[Date] ) )

Revenue YoY % =
DIVIDE ( [Revenue Won] - [Revenue Won PY], [Revenue Won PY] )

Revenue Won YTD =
TOTALYTD ( [Revenue Won], Calendar[Date] )

// Month-over-month change for the trend line tooltip
Revenue MoM % =
VAR PrevMonth =
    CALCULATE ( [Revenue Won], DATEADD ( Calendar[Date], -1, MONTH ) )
RETURN
    DIVIDE ( [Revenue Won] - PrevMonth, PrevMonth )


// ---------- 6. Sales-cycle measures ----------

Avg Days to Close =
CALCULATE ( AVERAGE ( leads[days_to_close] ), leads[is_open] = 0 )

// Fastest-moving segment indicator for the recommendations panel
Days to Close (Closed Only) =
CALCULATE (
    AVERAGE ( leads[days_to_close] ),
    leads[is_open] = 0,
    leads[is_won] = 1
)


// ---------- 7. Follow-up and pipeline health ----------

Stale Open Leads =
CALCULATE ( [Open Leads], leads[follow_up_status] = "Stale (>14 days)" )

Never Followed Up Leads =
CALCULATE ( [Open Leads], leads[follow_up_status] = "Never Followed Up" )

// Share of open pipeline that needs action right now
Pipeline At Risk % =
DIVIDE ( [Stale Open Leads] + [Never Followed Up Leads], [Open Leads], 0 )

Follow-up Coverage % =
DIVIDE (
    CALCULATE ( [Open Leads], leads[follow_ups] > 0 ),
    [Open Leads],
    0
)


// ---------- 8. Targets (requires a Targets table: month, target_revenue_inr) ----------

Revenue Target =
SUM ( Targets[target_revenue_inr] )

Target Attainment % =
DIVIDE ( [Revenue Won], [Revenue Target], BLANK () )


// ---------- 9. Leaderboard helpers ----------

// Name of the top region by revenue, for a dynamic headline card
Top Region =
MAXX (
    TOPN ( 1, ALL ( leads[region] ), [Revenue Won], DESC ),
    leads[region]
)

// Agent rank by closed win rate, only agents with at least 20 closed deals
Agent Win Rate Rank =
IF (
    [Won Leads] + [Lost Leads] >= 20,
    RANKX ( ALL ( agents[agent_name] ), [Closed Win Rate %], , DESC, Dense ),
    BLANK ()
)


// ---------- 10. Dynamic insight text for the recommendations panel ----------

Lead Source Insight =
VAR BestSource =
    MAXX ( TOPN ( 1, ALL ( leads[lead_source] ), [Closed Win Rate %], DESC ), leads[lead_source] )
VAR BestRate =
    CALCULATE ( [Closed Win Rate %], leads[lead_source] = BestSource )
RETURN
    "Best converting channel: " & BestSource & " (" & FORMAT ( BestRate, "0.0%" ) & " closed win rate)"

Pipeline Action Insight =
VAR AtRiskPct = [Pipeline At Risk %]
RETURN
    IF (
        AtRiskPct >= 0.5,
        FORMAT ( AtRiskPct, "0%" ) & " of open leads are stale or never followed up. Reassign or re-engage this week.",
        FORMAT ( AtRiskPct, "0%" ) & " of open leads are at risk. Keep follow-up cadence on track."
    )
